{
  "name": "torino-quest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/idle-visitor.test.mjs tests/database-errors.test.mjs tests/challonge-oauth.test.mjs tests/production-plan.test.mjs tests/checkin.test.mjs tests/decks.test.mjs tests/mirror-achievement.test.mjs tests/challonge-tournaments.test.mjs tests/local-development.test.mjs",
    "test:local": "node --env-file-if-exists=.env.local --test tests/local-impersonation-postgres.test.mjs",
    "test:decks": "node --env-file-if-exists=.env.local --test tests/stage-decks-postgres.test.mjs",
    "test:checkin": "node --env-file-if-exists=.env.local --test tests/checkin-postgres.test.mjs",
    "test:integration": "node --env-file-if-exists=.env.local --test tests/postgres-api.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-data.mjs",
    "tournament:sync": "node --env-file-if-exists=.env.local scripts/sync-tournament.mjs",
    "local:setup": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "postgres": "^3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
