# Server only: Supabase > Connect > Transaction pooler (port 6543).
DATABASE_URL=
# Supabase > Connect > Direct connection, or Session pooler (5432) for IPv4.
DATABASE_MIGRATION_URL=
STAFF_PASSPHRASE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Register an OAuth application on https://connect.challonge.com/
# Server-only credentials; never prefix these with NEXT_PUBLIC_.
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
# Must exactly match the callback registered with Challonge.
# Local: http://localhost:3000/api/auth/challonge/callback
CHALLONGE_REDIRECT_URI=
# Server-only API v1 key, used with the v2.1 API key authentication mode.
CHALLONGE_API_KEY=
